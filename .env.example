# cllient - Runtime-Configurable LLM Client
# Environment Variables Configuration
# Copy this file to .env and add your actual API keys

# =============================================================================
# Core LLM Provider API Keys
# =============================================================================

# OpenAI API Configuration
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration  
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek API Configuration
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# =============================================================================
# Additional Provider API Keys (Optional)
# =============================================================================

# Google AI Configuration
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here

# OpenRouter API Key (Access to multiple models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cohere API Key
COHERE_API_KEY=your_cohere_api_key_here

# =============================================================================
# cllient Configuration (Optional)
# =============================================================================

# Custom Configuration Directory
# Override default embedded configs with external YAML files
# CLLIENT_CONFIG_DIR=/path/to/custom/configs

# =============================================================================
# Logging and Debug Configuration (Optional)
# =============================================================================

# Rust logging level
# Options: error, warn, info, debug, trace
# RUST_LOG=info

# Enable verbose output for cllient commands
# CLLIENT_VERBOSE=false